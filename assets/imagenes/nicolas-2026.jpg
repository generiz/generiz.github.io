<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f5f5f2"><meta name="description" content="Nicolás Pintos — consultoría tecnológica, infraestructura, sistemas, seguridad y privacidad en línea.">
<title>Nicolás Pintos — Consultoría tecnológica</title>
<style>
:root{--bg:#f5f5f2;--ink:#111315;--muted:#687079;--line:#d7dade;--dark:#08111d;--dark2:#0d1726;--blue:#1f4b7a;--white:#fff;--max:1420px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}.shell{max-width:var(--max);margin:auto;padding:0 44px}.mono{font:600 10px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;text-transform:uppercase}.nav{position:fixed;z-index:50;inset:0 0 auto;height:72px;background:rgba(245,245,242,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(0,0,0,.07)}.navin{height:100%;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:12px;align-items:center;font-weight:700;letter-spacing:-.03em}.mark{width:32px;height:32px;border:1px solid #111;border-radius:50%;display:grid;place-items:center;font-size:10px}.links{display:flex;gap:26px;align-items:center;font-size:13px;color:#4f565e}.cta{border:1px solid #bdc2c6;border-radius:999px;padding:10px 15px;color:#111}.hero{min-height:100svh;padding-top:72px;display:grid;grid-template-columns:1.03fr .97fr}.copy{padding:clamp(86px,10vh,125px) 54px 58px max(44px,calc((100vw - var(--max))/2 + 44px));display:flex;flex-direction:column;justify-content:space-between}.eyebrow{color:var(--blue)}h1{margin:26px 0 30px;font-size:clamp(72px,8.2vw,148px);line-height:.82;letter-spacing:-.075em;font-weight:650}.role{font-size:clamp(25px,2.2vw,37px);line-height:1.13;letter-spacing:-.04em;max-width:760px;margin:0}.desc{font-size:16px;line-height:1.62;color:var(--muted);max-width:690px;margin:18px 0 0}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:32px}.btn{display:inline-flex;gap:14px;align-items:center;padding:14px 18px;border:1px solid #bec3c7;border-radius:999px;font-size:13px}.btn.primary{background:#111;color:#fff;border-color:#111}.meta{display:flex;gap:10px;flex-wrap:wrap;padding-top:54px}.chip{border:1px solid #d3d7da;border-radius:999px;padding:8px 11px;color:#59616a}.photo{position:relative;overflow:hidden;background:#142134;min-height:620px}.photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 20%;transform:scale(1.015)}.photo:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,12,20,.22),transparent 40%);pointer-events:none}.plabel{position:absolute;z-index:2;bottom:24px;left:24px;color:#e7edf3}section{border-top:1px solid var(--line)}.section{padding:118px 0}.grid{display:grid;grid-template-columns:220px 1fr;gap:68px}.idx{color:#7a8188;padding-top:8px}.big{margin:0;font-size:clamp(42px,5.2vw,80px);line-height:1.03;letter-spacing:-.058em;max-width:1050px}.dark{background:var(--dark);color:#eef3f7}.dark2{background:var(--dark2);color:#eef3f7}.dark .idx,.dark2 .idx{color:#82909d}.headline{font-size:clamp(54px,6.5vw,104px);line-height:.93;letter-spacing:-.065em;margin:0;font-weight:610}.lead{max-width:720px;color:#9ea9b3;line-height:1.62;font-size:17px;margin:27px 0 0}.rows{margin-top:66px;border-top:1px solid #283443}.row{display:grid;grid-template-columns:78px minmax(250px,.7fr) 1fr;gap:26px;padding:32px 0;border-bottom:1px solid #283443}.row h3{font-size:clamp(24px,2.2vw,36px);letter-spacing:-.04em;margin:0;font-weight:520}.row p{margin:3px 0 0;color:#9ca6af;line-height:1.6}.num{color:#6f8aa5}.secgrid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:58px}.seccard{padding:28px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.025)}.seccard h3{font-size:28px;letter-spacing:-.04em;margin:0 0 8px;font-weight:540}.seccard p{color:#a3adb7;line-height:1.6;margin:0}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.tag{border:1px solid rgba(255,255,255,.13);border-radius:999px;padding:10px 12px;color:#d5dde5}.projects{margin-top:62px;border-top:1px solid var(--line)}.project{display:grid;grid-template-columns:160px 1fr auto;gap:30px;align-items:center;padding:35px 0;border-bottom:1px solid var(--line)}.ptype{color:#7a8188}.pname{font-size:clamp(30px,3vw,48px);letter-spacing:-.045em}.round{width:46px;height:46px;border:1px solid #c0c5ca;border-radius:50%;display:grid;place-items:center}.ufo{background:#07111c;color:#fff;padding:105px 0}.uword{font-size:clamp(100px,19vw,285px);line-height:.8;letter-spacing:-.095em;font-weight:660;margin:42px 0 58px}.ubottom{display:grid;grid-template-columns:1fr auto;gap:50px;align-items:end}.ucopy{max-width:620px;color:#bcc8d2;font-size:22px;line-height:1.38;margin:0}.ufo .btn{border-color:#34475a}.ufo .primary{background:#fff;color:#08111d;border-color:#fff}.tech{padding:100px 0}.techgroups{margin-top:52px;border-top:1px solid var(--line)}.techrow{display:grid;grid-template-columns:220px 1fr;gap:68px;padding:27px 0;border-bottom:1px solid var(--line)}.techlabel{color:#7a8188;padding-top:5px}.techlist{display:flex;flex-wrap:wrap;gap:10px 22px;font-size:20px;line-height:1.5}.edu{margin-top:58px;border-top:1px solid var(--line)}.edur{display:grid;grid-template-columns:140px 1fr;gap:28px;padding:32px 0;border-bottom:1px solid var(--line)}.estatus{color:#7a8188;padding-top:6px}.etitle{font-size:clamp(29px,3vw,48px);line-height:1.03;letter-spacing:-.045em}.contact{background:#e7e9eb}.contactlinks{margin-top:62px;border-top:1px solid #c3c7cb}.contactlinks a{display:grid;grid-template-columns:1fr auto;padding:21px 0;border-bottom:1px solid #c3c7cb;font-size:20px}.footer{display:flex;justify-content:space-between;gap:25px;padding-top:52px;color:#747b82}.reveal{opacity:0;transform:translateY(22px);transition:.65s ease}.reveal.on{opacity:1;transform:none}@media(max-width:900px){.shell{padding:0 22px}.links a:not(.cta){display:none}.hero{grid-template-columns:1fr}.copy{padding:112px 22px 50px;min-height:700px}.photo{min-height:72svh}.grid,.techrow{grid-template-columns:1fr;gap:24px}.row{grid-template-columns:48px 1fr}.row p{grid-column:2}.secgrid{grid-template-columns:1fr}.project{grid-template-columns:90px 1fr auto}.ubottom{grid-template-columns:1fr}.techrow{gap:10px}}@media(max-width:560px){h1{font-size:70px}.section,.ufo,.tech{padding-top:86px;padding-bottom:86px}.project{grid-template-columns:1fr auto}.ptype{grid-column:1/-1}.uword{font-size:30vw}.edur{grid-template-columns:1fr;gap:8px}.footer{flex-direction:column}}
</style>
</head>
<body>
<header class="nav"><div class="shell navin"><a class="brand" href="#inicio"><span class="mark">NP</span>Nicolás Pintos</a><nav class="links"><a href="#consultoria">Consultoría</a><a href="#seguridad">Seguridad</a><a href="#proyectos">Proyectos</a><a href="#ufotech">ufotech</a><a class="cta" href="https://wa.me/595991414172" target="_blank" rel="noopener">Contacto ↗</a></nav></div></header>
<main id="inicio">
<section class="hero"><div class="copy"><div><div class="mono eyebrow">Consultoría tecnológica · Infraestructura · Seguridad · Privacidad</div><h1>Nicolás<br>Pintos.</h1><p class="role">Consultoría tecnológica, infraestructura, sistemas, seguridad y privacidad en línea.</p><p class="desc">Trabajo con empresas y profesionales en soporte, redes, servidores, sistemas, compras tecnológicas, seguridad operativa y privacidad en línea.</p><div class="actions"><a class="btn primary" href="https://wa.me/595991414172" target="_blank" rel="noopener">WhatsApp ↗</a><a class="btn" href="#consultoria">Consultoría ↓</a></div></div><div class="meta"><span class="mono chip">20+ años en tecnología</span><span class="mono chip">Consultoría IT</span><span class="mono chip">Seguridad y privacidad</span><span class="mono chip">Fundador de ufotech</span></div></div><div class="photo"><img src="assets/imagenes/nicolas-2026.jpg" alt="Nicolás Pintos"><div class="mono plabel">Paraguay</div></div></section>
<section class="section"><div class="shell grid reveal"><div class="mono idx">01 / Perfil</div><p class="big">Tecnología aplicada a necesidades concretas de operación, soporte e infraestructura.</p></div></section>
<section class="section dark" id="consultoria"><div class="shell"><div class="grid reveal"><div class="mono idx">02 / Consultoría</div><div><h2 class="headline">Consultoría IT</h2><p class="lead">Diagnóstico, diseño e implementación de infraestructura, redes, soporte, sistemas y procesos tecnológicos.</p></div></div><div class="rows reveal"><div class="row"><div class="mono num">01</div><h3>Infraestructura y redes</h3><p>Redes cableadas y Wi‑Fi, switching, VPN, NAS, servidores, respaldos y acceso remoto.</p></div><div class="row"><div class="mono num">02</div><h3>Soporte y continuidad</h3><p>Diagnóstico, mantenimiento, recuperación, soporte a usuarios y continuidad operativa.</p></div><div class="row"><div class="mono num">03</div><h3>Tecnología y compras</h3><p>Especificación, evaluación y selección de equipos según uso, presupuesto y operación.</p></div><div class="row"><div class="mono num">04</div><h3>Sistemas y automatización</h3><p>Herramientas internas, soluciones web, integraciones y automatización de procesos.</p></div></div></div></section>
<section class="section dark2" id="seguridad"><div class="shell"><div class="grid reveal"><div class="mono idx">03 / Seguridad</div><div><h2 class="headline">Seguridad y privacidad en línea</h2><p class="lead">Configuración de accesos, MFA, VPN, copias de seguridad, gestión de credenciales, segmentación y reducción de exposición innecesaria.</p></div></div><div class="secgrid reveal"><div class="seccard"><h3>Seguridad operativa</h3><p>Accesos, buenas prácticas, endurecimiento básico, copias de seguridad y reducción de superficie de ataque.</p></div><div class="seccard"><h3>Privacidad</h3><p>Navegación, comunicación, segmentación y criterios para exponer solamente la información necesaria.</p></div></div><div class="tags reveal"><span class="mono tag">MFA</span><span class="mono tag">VPN</span><span class="mono tag">Backups</span><span class="mono tag">Gestión de accesos</span><span class="mono tag">Segmentación</span><span class="mono tag">Hardening básico</span></div></div></section>
<section class="section" id="proyectos"><div class="shell"><div class="grid reveal"><div class="mono idx">04 / Proyectos</div><h2 class="headline">Proyectos</h2></div><div class="projects reveal"><div class="project"><div class="mono ptype">Empresa</div><div class="pname">ufotech</div><a class="round" href="#ufotech">↓</a></div><div class="project"><div class="mono ptype">Open source</div><div class="pname">AnyDesk Virtual Display Fix</div><a class="round" href="https://github.com/generiz/AnydeskVirtualDisplayFix" target="_blank" rel="noopener">↗</a></div><div class="project"><div class="mono ptype">Sistemas</div><div class="pname">Herramientas internas y automatización</div><a class="round" href="https://github.com/generiz" target="_blank" rel="noopener">↗</a></div></div></div></section>
<section class="ufo" id="ufotech"><div class="shell reveal"><div class="mono idx">05 / Proyecto principal</div><div class="uword">ufotech</div><div class="ubottom"><p class="ucopy">Tecnología para personas y empresas: equipos, soporte, infraestructura y sistemas.</p><div class="actions"><a class="btn primary" href="https://ufotech.com.py" target="_blank" rel="noopener">ufotech.com.py ↗</a><a class="btn" href="https://ufotech.com.py" target="_blank" rel="noopener">Shop ↗</a></div></div></div></section>
<section class="tech" id="tecnologias"><div class="shell reveal"><div class="grid"><div class="mono idx">06 / Tecnologías</div><h2 class="headline">Tecnologías y plataformas</h2></div><div class="techgroups"><div class="techrow"><div class="mono techlabel">Infraestructura</div><div class="techlist"><span>TP-Link Omada</span><span>Ubiquiti</span><span>TrueNAS</span><span>Tailscale</span><span>Docker</span><span>Linux</span><span>Windows</span></div></div><div class="techrow"><div class="mono techlabel">Web y servicios</div><div class="techlist"><span>Cloudflare</span><span>GitHub</span><span>HTML / CSS / JavaScript</span><span>Flask</span><span>Supabase</span></div></div><div class="techrow"><div class="mono techlabel">Seguridad y acceso</div><div class="techlist"><span>MFA</span><span>VPN</span><span>Gestión de accesos</span><span>Backups</span><span>Segmentación</span><span>AnyDesk</span></div></div></div></div></section>
<section class="section" id="formacion"><div class="shell grid reveal"><div class="mono idx">07 / Formación</div><div><h2 class="headline">Formación</h2><div class="edu"><div class="edur"><div class="mono estatus">En curso</div><div class="etitle">Ingeniería en Tecnologías e Innovación</div></div><div class="edur"><div class="mono estatus">Formación</div><div class="etitle">Licenciatura en Tecnología de la Información</div></div></div></div></div></section>
<section class="section contact" id="contacto"><div class="shell"><div class="grid reveal"><div class="mono idx">08 / Contacto</div><div><h2 class="headline">Contacto</h2><p class="desc">Consultoría IT · Infraestructura · Sistemas · Seguridad · Privacidad</p></div></div><div class="contactlinks reveal"><a href="https://wa.me/595991414172" target="_blank" rel="noopener"><span>WhatsApp</span><span>↗</span></a><a href="https://www.linkedin.com/in/nicolaspintos/" target="_blank" rel="noopener"><span>LinkedIn</span><span>↗</span></a><a href="https://github.com/generiz" target="_blank" rel="noopener"><span>GitHub</span><span>↗</span></a><a href="https://t.me/nicolas_pintos" target="_blank" rel="noopener"><span>Telegram</span><span>↗</span></a></div><div class="mono footer"><span>© <span id="year"></span> Nicolás Pintos</span><span>nicolaspintos.com</span></div></div></section>
</main>
<script>document.getElementById('year').textContent=new Date().getFullYear();const o=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('on');o.unobserve(x.target)}}),{threshold:.1});document.querySelectorAll('.reveal').forEach(x=>o.observe(x));</script>
</body></html>